# Copy to .env.local and fill in. Never commit real values.

# --- Contentful (content) -----------------------------------------------------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_REGION=us                  # us | eu (data residency of the space)
CONTENTFUL_DELIVERY_TOKEN=            # Content Delivery API token (published content only)
CONTENTFUL_PREVIEW_TOKEN=             # Content Preview API token (drafts; server-side only)
CONTENTFUL_PREVIEW_SECRET=            # random string in the content preview URL (?cf_preview=<secret>); unlocks drafts
# Management API: modeling/seeding scripts only, never used by the storefront
CONTENTFUL_MANAGEMENT_TOKEN=

# --- BigCommerce (Storefront GraphQL, channel-scoped token) -----------------
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=         # created per origin (http://localhost:3000, production domain)
